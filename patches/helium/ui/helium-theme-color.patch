+  if (key.helium_theme_color) {
+    SkColor theme_color = *key.helium_theme_color;
+    mixer[kColorToolbar] = { theme_color };
+    
+    // Calculate contrast and background for omnibox (location bar)
+    SkColor contrast_color = color_utils::GetColorWithMaxContrast(theme_color);
+    bool is_dark = (contrast_color == SK_ColorWHITE);
+    SkColor location_bar_bg = is_dark ? SkColorSetA(SK_ColorWHITE, 0x1F)
+                                      : SkColorSetA(SK_ColorBLACK, 0x14);
+    
+    mixer[kColorLocationBarBackground] = { color_utils::GetResultingPaintColor(location_bar_bg, theme_color) };
+    mixer[kColorToolbarButtonText] = { contrast_color };
+    mixer[kColorToolbarButtonIcon] = { contrast_color };
+    mixer[kColorToolbarButtonIconHovered] = { contrast_color };
+    mixer[kColorToolbarButtonIconPressed] = { contrast_color };
+    mixer[kColorToolbarText] = { contrast_color };
+    
+    // Active tab background and foreground
+    mixer[kColorTabBackgroundActiveFrameActive] = { kColorLocationBarBackground };
+    mixer[kColorTabForegroundActiveFrameActive] = { contrast_color };
+    
+    // Inactive tab text/icons
+    mixer[kColorTabForegroundInactiveFrameActive] = { SkColorSetA(contrast_color, 0xB2) }; // 70% opacity for inactive tab text
+    
+    // Caption buttons (minimize, maximize, close) should have maximum contrast too!
+    mixer[kColorFrameCaptionActive] = { contrast_color };
