+void BrowserView::UpdateHeliumThemeColor() {
+  std::optional<SkColor> color;
+  if (content::WebContents* web_contents = GetActiveWebContents()) {
+    color = web_contents->GetThemeColor();
+    if (color) {
+      color = SkColorSetA(*color, SK_AlphaOPAQUE);
+    }
+  }
+
+  if (!browser_widget()) {
+    return;
+  }
+
+  browser_widget()->SetHeliumThemeColor(color);
 }
 
