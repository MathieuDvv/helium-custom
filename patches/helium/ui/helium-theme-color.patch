+ui::ColorProviderKey BrowserFrame::GetColorProviderKey() const {
+  auto key = views::Widget::GetColorProviderKey();
+  key.helium_theme_color = helium_theme_color_;
+  return key;
+}
+
+void BrowserFrame::SetHeliumThemeColor(std::optional<SkColor> color) {
+  if (helium_theme_color_ == color)
+    return;
+  helium_theme_color_ = color;
+  ThemeChanged();
+}

