 #include "ui/views/widget/widget.h"
 
+BrowserView::ActiveTabThemeObserver::ActiveTabThemeObserver(BrowserView* browser_view)
+    : browser_view_(browser_view) {}
+
+BrowserView::ActiveTabThemeObserver::~ActiveTabThemeObserver() = default;
+
+void BrowserView::ActiveTabThemeObserver::SetWebContents(content::WebContents* web_contents) {
+  Observe(web_contents);
+  UpdateThemeColor();
+}
+
+void BrowserView::ActiveTabThemeObserver::DidChangeThemeColor(std::optional<SkColor> theme_color) {
+  UpdateThemeColor();
+}
+
+void BrowserView::ActiveTabThemeObserver::UpdateThemeColor() {
+  std::optional<SkColor> color;
+  if (web_contents()) {
+    color = web_contents()->GetThemeColor();
+  }
+  browser_view_->UpdateHeliumThemeColor(color);
+}
+
+void BrowserView::UpdateHeliumThemeColor(std::optional<SkColor> color) {
+  if (frame()) {
+    frame()->SetHeliumThemeColor(color);
+  }
+}
